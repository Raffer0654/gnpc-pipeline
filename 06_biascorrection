from pathlib import Path

import numpy as np
import pandas as pd
import joblib
from sklearn.pipeline import Pipeline

DEBUG = True

MODEL_ROOT = Path("/home/jovyan/work/raffer pipelineScripts/results_imputation_miss30")
CN_DATA_PATH = Path("../GNPC Harmonised Dataset v1/Clinical/processed_data_v4_python/gnpc_processed.pkl")
DISEASE_DATA_PATH = Path("../GNPC Harmonised Dataset v1/Clinical/processed_data_v4_python/gnpc_processed_noncontrol.pkl")
ORG_MAP_PATH = Path("../GNPC Harmonised Dataset v1/Clinical/processed_data_v4_python/organ_system_mapping.json")

OUT_DIR = Path("/home/jovyan/work/raffer pipelineScripts/results_disease_comparison_trainingCorrection_imp")
OUT_DIR.mkdir(parents=True, exist_ok=True)

OUT_PATH_WIDE = OUT_DIR / "disease_BAG_predictions_trainingCorrected_wide_allDisease_imp.csv"
OUT_PATH_LONG = OUT_DIR / "disease_BAG_predictions_trainingCorrected_long_allDisease_imp.csv"
