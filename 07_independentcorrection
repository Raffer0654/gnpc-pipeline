#!/usr/bin/env python
# 07_independentcorrection.py
#
# DISEASE BAG PREDICTION - RAW + INDEPENDENT AGE BIAS CORRECTION
#
# This implements the paper's "independent correction" style:
#   1) For each disease and organ, predict age in that disease-positive cohort.
#   2) Fit BAG age-bias parameters within that same disease/organ cohort.
#   3) Apply those disease/organ-specific parameters back to that same cohort.
#
# Bias correction (BAG-based):
#   BAG_raw = y_pred - age
#   Fit in target cohort: BAG_raw = alpha_independent * age + beta_independent
#   Apply in target cohort: BAG_corrected = BAG_raw - (alpha_independent * age + beta_independent)

import sys

import json
from pathlib import Path

import numpy as np
import pandas as pd
import joblib
from sklearn.pipeline import Pipeline

# ============================================================
# CONFIG
# ============================================================

DEBUG = True

MODEL_ROOT = Path("/home/jovyan/work/raffer pipelineScripts/results_imputation_miss30")

DISEASE_DATA_PATH = Path("../GNPC Harmonised Dataset v1/Clinical/processed_data_v4_python/gnpc_processed_noncontrol.pkl")
ORG_MAP_PATH = Path("../GNPC Harmonised Dataset v1/Clinical/processed_data_v4_python/organ_system_mapping.json")

OUT_DIR = Path("/home/jovyan/work/raffer pipelineScripts/results_disease_comparison_independentCorrection_imp")
OUT_DIR.mkdir(parents=True, exist_ok=True)

OUT_PATH_WIDE = OUT_DIR / "disease_BAG_predictions_independentCorrected_wide_allDisease_imp.csv"
OUT_PATH_LONG = OUT_DIR / "disease_BAG_predictions_independentCorrected_long_allDisease_imp.csv"
PARAMS_USED_OUT_PATH = OUT_DIR / "disease_bias_params_used_independentCorrection_allDisease_imp.csv"

MODEL_SELECT_METRIC = "test_mae"
DROPNA_FEATURE_ROWS = True

FALLBACK_IF_BAD_INDEPENDENT_FIT = "raw"  # "raw" or "nan"
MIN_N_TO_FIT_BIAS = 30
MIN_APPLY_N = 30

EXPECTED_MODELS = ("lasso", "en", "svr")

# ============================================================
# HELPERS
# ============================================================

def looks_like_estimator(obj) -> bool:
    return hasattr(obj, "predict") and callable(getattr(obj, "predict"))

def get_model_label(model_obj):
    if isinstance(model_obj, Pipeline) and hasattr(model_obj, "named_steps") and "model" in model_obj.named_steps:
        est = model_obj.named_steps["model"]
        name = type(est).__name__.lower()
        if "svr" in name:
            return "svr"
        if "lasso" in name:
            return "lasso"
        if "elasticnet" in name or "elastic_net" in name:
            return "en"
        return name
    return type(model_obj).__name__.lower()

def fail_loud_all_nan_columns(X_df: pd.DataFrame, organ: str):
    col_medians = X_df.median(axis=0, skipna=True)
    all_nan_cols = col_medians[col_medians.isna()].index.tolist()
    if all_nan_cols:
        raise ValueError(
            f"[{organ}] Found {len(all_nan_cols)} ALL-NaN protein columns "
            f"(example: {all_nan_cols[:10]}). Fix upstream missingness or drop/retrain."
        )
    return col_medians

def safe_read_json(path: Path):
    if not path.exists():
        return None
    try:
        with open(path, "r") as f:
            return json.load(f)
    except Exception:
        return None

def discover_candidate_models_for_organ(organ: str):
    out = []
    organ_dir = MODEL_ROOT / organ
    if not organ_dir.exists():
        return out

    for model_tag in EXPECTED_MODELS:
        md = organ_dir / model_tag
        if not md.exists():
            continue
        mpath = md / "best_model.joblib"
        metrics = safe_read_json(md / "metrics.json")
        out.append({
            "model_tag": model_tag,
            "model_dir": md,
            "best_model_path": mpath if mpath.exists() else None,
            "metrics": metrics,
        })
    return out

def pick_best_model_candidate(cands, metric_key: str):
    scored = []
    for c in cands:
        if c["best_model_path"] is None:
            continue

        metrics = c.get("metrics") or {}
        val = metrics.get(metric_key, None)

        if val is None:
            if metric_key == "test_mae":
                val = metrics.get("nested_cv_mae_mean", None)
            elif metric_key == "nested_cv_mae_mean":
                val = metrics.get("test_mae", None)

        if val is None:
            continue

        try:
            scored.append((float(val), c))
        except Exception:
            continue

    if scored:
        scored.sort(key=lambda x: x[0])
        return scored[0][1]

    for c in cands:
        if c["best_model_path"] is not None:
            return c

    return None

def subset_for_organ(base_df: pd.DataFrame, organ: str) -> pd.DataFrame:
    if "sex" in base_df.columns:
        if organ == "Female_Reproductive":
            return base_df[base_df["sex"] == 2].copy()
        if organ == "Male_Reproductive":
            return base_df[base_df["sex"] == 1].copy()
    return base_df.copy()

def prepare_X_and_rows(input_df: pd.DataFrame, feat_list: list[str], organ: str):
    missing_feats = [f for f in feat_list if f not in input_df.columns]
    if missing_feats:
        if DEBUG:
            print(f"Skipping {organ}: missing {len(missing_feats)} proteins (e.g., {missing_feats[:5]}).")
        return None, None

    work_df = input_df.copy()
    X_df = work_df[feat_list].astype("float32")

    col_medians = fail_loud_all_nan_columns(X_df, organ)

    if DROPNA_FEATURE_ROWS:
        before_rows = len(work_df)
        mask_complete = ~X_df.isna().any(axis=1)
        work_df = work_df.loc[mask_complete].copy()
        X_df = X_df.loc[mask_complete].copy()
        if DEBUG:
            print(f"  [{organ}] dropna rows: {before_rows} -> {len(work_df)}")
    else:
        X_df = X_df.fillna(col_medians)

    if work_df.empty:
        return None, None

    return work_df, X_df

def fit_bias_params(age_vec: np.ndarray, y_pred_vec: np.ndarray):
    """
    Fit BAG_raw ~ age.
    Returns alpha, beta such that BAG_raw ~= alpha * age + beta.
    """
    age_vec = np.asarray(age_vec, dtype=float)
    y_pred_vec = np.asarray(y_pred_vec, dtype=float)

    mask = np.isfinite(age_vec) & np.isfinite(y_pred_vec)
    age_fit = age_vec[mask]
    pred_fit = y_pred_vec[mask]

    if len(age_fit) < MIN_N_TO_FIT_BIAS:
        return np.nan, np.nan, len(age_fit), "too_few_samples"

    if np.nanstd(age_fit) == 0:
        return np.nan, np.nan, len(age_fit), "no_age_variation"

    try:
        bag_fit = pred_fit - age_fit
        alpha, beta = np.polyfit(age_fit, bag_fit, 1)
        return float(alpha), float(beta), len(age_fit), "fit_success"
    except Exception:
        return np.nan, np.nan, len(age_fit), "fit_failed"

def apply_bias_correction(age_vec: np.ndarray, y_pred_vec: np.ndarray, alpha: float, beta: float):
    age_vec = np.asarray(age_vec, dtype=float)
    y_pred_vec = np.asarray(y_pred_vec, dtype=float)
    bag_raw = y_pred_vec - age_vec
    bag_corr = bag_raw - (alpha * age_vec + beta)
    return bag_corr

def positive_diseases_row(row: pd.Series, disease_cols: list[str]) -> list[str]:
    return [d for d in disease_cols if int(row.get(d, 0)) == 1]

# ============================================================
# LOAD DATA + MAP
# ============================================================

print("-" * 70)
print("LOADING DISEASE DATA + ORGAN MAP + MODELS")
print("-" * 70)

if not DISEASE_DATA_PATH.exists():
    raise FileNotFoundError(f"Disease data not found: {DISEASE_DATA_PATH}")
df = pd.read_pickle(DISEASE_DATA_PATH)
print(f"Loaded disease dataframe: {df.shape}")

if not ORG_MAP_PATH.exists():
    raise FileNotFoundError(f"Organ mapping not found: {ORG_MAP_PATH}")
with open(ORG_MAP_PATH, "r") as f:
    organ_map = json.load(f)
print(f"Loaded organ_system_mapping.json with {len(organ_map)} organs")

if not MODEL_ROOT.exists():
    raise FileNotFoundError(f"MODEL_ROOT not found: {MODEL_ROOT}")
print(f"Using MODEL_ROOT: {MODEL_ROOT}")

if "age" not in df.columns:
    raise KeyError("Disease dataframe missing required column: age")
if "sample_id" not in df.columns:
    raise KeyError("Disease dataframe missing required column: sample_id")

df = df[df["age"].notna()].copy()
df["sample_id"] = df["sample_id"].astype(str)

# ============================================================
# DISEASE CLEANING
# ============================================================

disease_cols = [
    "stroke", "tia", "tbi", "ad", "ftd", "pd", "als", "mci_sci",
    "cancer", "diabetes", "chf", "copd", "mi", "afib", "angina",
    "hyperlipidaemia", "hypertension", "depression", "anxiety"
]
disease_cols = [c for c in disease_cols if c in df.columns]
print(f"\nFound {len(disease_cols)} disease label columns in disease df.")

if disease_cols:
    df[disease_cols] = df[disease_cols].replace({-1: 0, 2: 0})
    df[disease_cols] = df[disease_cols].clip(0, 1).astype(int)
    df["disease_count"] = df[disease_cols].sum(axis=1).astype(int)
else:
    df["disease_count"] = 0

df_all_disease = df[df["disease_count"] >= 1].copy()
df_all_disease["is_single_disease"] = (df_all_disease["disease_count"] == 1).astype(int)

print(f"All disease-positive cohort: N={len(df_all_disease):,}")

# ============================================================
# PICK ONE BEST MODEL PER ORGAN
# ============================================================

orgs_to_run = [o for o in organ_map.keys()]
organ_best = {}

for organ in orgs_to_run:
    cands = discover_candidate_models_for_organ(organ)
    best = pick_best_model_candidate(cands, MODEL_SELECT_METRIC)
    if best is None:
        continue

    organ_best[organ] = {
        "model_tag": best["model_tag"],
        "model_path": best["best_model_path"],
        "metrics": best.get("metrics"),
        "model_dir": best["model_dir"],
    }

print(f"\nSelected best model for {len(organ_best)} organs (based on {MODEL_SELECT_METRIC}).")
if DEBUG:
    for org in sorted(organ_best.keys()):
        meta = organ_best[org]
        m = meta.get("metrics") or {}
        print(
            f"  {org:20s} -> {meta['model_tag']:5s} | "
            f"test_mae={m.get('test_mae', None)} | nested_cv_mae_mean={m.get('nested_cv_mae_mean', None)}"
        )

# ============================================================
# FIT/APPLY INDEPENDENT CORRECTION WITHIN EACH DISEASE COHORT
# ============================================================

params_used_rows = []
long_records = []
model_cache = {}

print("\n" + "=" * 70)
print("RUNNING INDEPENDENT AGE BIAS CORRECTION")
print("For each disease/organ: fit BAG_raw ~ age in that cohort, then apply to same cohort")
print("=" * 70)

for disease in disease_cols:
    apply_base = df_all_disease[df_all_disease[disease] == 1].copy()

    if len(apply_base) < MIN_APPLY_N:
        if DEBUG:
            print(f"\n[{disease}] skipped entirely: apply_N={len(apply_base)} < {MIN_APPLY_N}")
        continue

    print(f"\n[{disease}] independent correction cohort N={len(apply_base):,}")

    for organ in sorted(organ_best.keys()):
        feat_list = organ_map[organ]
        model_tag = organ_best[organ]["model_tag"]

        apply_df_org = subset_for_organ(apply_base, organ)
        apply_n_org = len(apply_df_org)

        if apply_n_org < MIN_APPLY_N:
            if DEBUG:
                print(f"  {organ:20s} skipped: cohort_N_org={apply_n_org} < {MIN_APPLY_N}")
            params_used_rows.append({
                "Disease": disease,
                "organ": organ,
                "model": model_tag,
                "alpha_independent": np.nan,
                "beta_independent": np.nan,
                "fit_status": "skipped_small_subset",
                "correction_status": "skipped_small_subset",
                "fit_N_independent": apply_n_org,
                "out_path_wide": str(OUT_PATH_WIDE),
                "out_path_long": str(OUT_PATH_LONG),
            })
            continue

        apply_df_org, X_apply_df = prepare_X_and_rows(apply_df_org, feat_list, organ)
        if apply_df_org is None or X_apply_df is None or apply_df_org.empty:
            continue

        apply_n_post = len(apply_df_org)
        if apply_n_post < MIN_APPLY_N:
            if DEBUG:
                print(f"  {organ:20s} skipped after dropna: cohort_N_post={apply_n_post} < {MIN_APPLY_N}")
            params_used_rows.append({
                "Disease": disease,
                "organ": organ,
                "model": model_tag,
                "alpha_independent": np.nan,
                "beta_independent": np.nan,
                "fit_status": "skipped_small_subset_after_dropna",
                "correction_status": "skipped_small_subset_after_dropna",
                "fit_N_independent": apply_n_post,
                "out_path_wide": str(OUT_PATH_WIDE),
                "out_path_long": str(OUT_PATH_LONG),
            })
            continue

        model = model_cache.get(organ)
        if model is None:
            model = joblib.load(organ_best[organ]["model_path"])
            if not looks_like_estimator(model):
                raise ValueError(f"[{organ}] Loaded object is not a predictor: {organ_best[organ]['model_path']}")
            model_cache[organ] = model

        X_apply_np = X_apply_df.to_numpy(dtype=np.float32)
        apply_age = apply_df_org["age"].astype(float).to_numpy()
        apply_sid = apply_df_org["sample_id"].to_numpy()
        apply_pred_raw = model.predict(X_apply_np).astype(float)
        apply_bag_raw = apply_pred_raw - apply_age

        alpha, beta, fit_n, fit_status = fit_bias_params(apply_age, apply_pred_raw)

        if np.isfinite(alpha) and np.isfinite(beta):
            apply_bag_corr = apply_bias_correction(apply_age, apply_pred_raw, alpha, beta)
            apply_pred_corr = apply_age + apply_bag_corr
            correction_status = "applied_independent_correction_params"
        else:
            correction_status = f"no_valid_independent_fit__{fit_status}"
            if FALLBACK_IF_BAD_INDEPENDENT_FIT == "nan":
                apply_pred_corr = np.full_like(apply_pred_raw, np.nan, dtype=float)
                apply_bag_corr = np.full_like(apply_pred_raw, np.nan, dtype=float)
            else:
                apply_pred_corr = apply_pred_raw.copy()
                apply_bag_corr = apply_bag_raw.copy()
                correction_status += "__raw_fallback"

        params_used_rows.append({
            "Disease": disease,
            "organ": organ,
            "model": model_tag,
            "alpha_independent": alpha,
            "beta_independent": beta,
            "fit_status": fit_status,
            "correction_status": correction_status,
            "fit_N_independent": fit_n,
            "out_path_wide": str(OUT_PATH_WIDE),
            "out_path_long": str(OUT_PATH_LONG),
        })

        for i in range(len(apply_sid)):
            row_i = apply_df_org.iloc[i]
            pos_dis = positive_diseases_row(row_i, disease_cols)
            rec = {
                "sample_id": str(apply_sid[i]),
                "Disease": disease,
                "organ": organ,
                "model": model_tag,
                "disease_count": int(row_i.get("disease_count", len(pos_dis))),
                "is_single_disease": int(row_i.get("is_single_disease", int(len(pos_dis) == 1))),
                "age_chron": float(apply_age[i]),
                "age_pred_raw": float(apply_pred_raw[i]),
                "BAG_raw": float(apply_bag_raw[i]),
                "age_pred_corrected_independent": float(apply_pred_corr[i]) if np.isfinite(apply_pred_corr[i]) else np.nan,
                "BAG_corrected_independent": float(apply_bag_corr[i]) if np.isfinite(apply_bag_corr[i]) else np.nan,
                "alpha_independent": alpha,
                "beta_independent": beta,
                "fit_status": fit_status,
                "correction_status": correction_status,
            }

            for dc in disease_cols:
                rec[dc] = int(row_i[dc]) if dc in row_i.index else 0

            long_records.append(rec)

        if DEBUG:
            print(
                f"  {organ:20s} ({model_tag}) alpha={alpha:+.4f}, beta={beta:+.4f}, "
                f"fit_N={fit_n}, status={correction_status}"
            )

# ============================================================
# SAVE LONG
# ============================================================

out_long = pd.DataFrame(long_records)

if len(out_long) == 0:
    raise RuntimeError("No records were produced. Check cohort sizes, protein coverage, and organ/model availability.")

print("\n" + "-" * 70)
print(f"Saving LONG all-disease predictions:\n  {OUT_PATH_LONG}")
out_long.to_csv(OUT_PATH_LONG, index=False)

# ============================================================
# MAKE WIDE
# ============================================================

wide_bag = (
    out_long.pivot_table(
        index=["sample_id", "Disease", "age_chron"],
        columns="organ",
        values="BAG_corrected_independent",
        aggfunc="first",
    )
    .reset_index()
)

non_organ_cols = {"sample_id", "Disease", "age_chron"}
wide_bag = wide_bag.rename(
    columns={
        c: f"{c}_BAG_corrected_independent"
        for c in wide_bag.columns
        if c not in non_organ_cols
    }
)

merge_cols = ["sample_id", "disease_count", "is_single_disease"] + disease_cols
if "sex" in df_all_disease.columns:
    merge_cols.append("sex")

wide_out = wide_bag.merge(
    df_all_disease[merge_cols].drop_duplicates("sample_id"),
    on="sample_id",
    how="left",
)

ordered_cols = (
    ["sample_id", "Disease", "age_chron"] +
    (["sex"] if "sex" in wide_out.columns else []) +
    ["disease_count", "is_single_disease"] +
    sorted([c for c in wide_out.columns if c.endswith("_BAG_corrected_independent")]) +
    [c for c in disease_cols if c in wide_out.columns]
)

wide_out = wide_out[ordered_cols].copy()

print(f"Saving WIDE all-disease predictions:\n  {OUT_PATH_WIDE}")
wide_out.to_csv(OUT_PATH_WIDE, index=False)

# ============================================================
# SAVE PARAMS USED
# ============================================================

params_used_df = (
    pd.DataFrame(params_used_rows)
    .drop_duplicates(subset=["Disease", "organ", "model"])
    .sort_values(["Disease", "organ", "model"])
    .reset_index(drop=True)
)

print(f"Saving independent-correction params used table:\n  {PARAMS_USED_OUT_PATH}")
params_used_df.to_csv(PARAMS_USED_OUT_PATH, index=False)

print("-" * 70)
print("Done.\n")
print("LONG predictions saved to :", OUT_PATH_LONG)
print("WIDE predictions saved to :", OUT_PATH_WIDE)
print("Params-used saved to      :", PARAMS_USED_OUT_PATH)
